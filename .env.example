# =============================================================================
#  GeoSms911 - configuracion
#  Copia este archivo como  .env  y completa los valores reales.
#  NUNCA subas el .env a un repositorio.
# =============================================================================

# --- Seguridad ---------------------------------------------------------------
# Clave para firmar los tokens de sesion. Genera una nueva con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=cambia-esta-clave-por-una-aleatoria-de-48-bytes

# URL publica donde Twilio puede alcanzar este backend (ngrok, Cloudflare
# Tunnel o tu dominio). Sin barra final.
# Ejemplo con ngrok:  https://a1b2c3d4.ngrok-free.app
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Permitir que se registren nuevas cuentas de tutor desde el dashboard.
ALLOW_REGISTRATION=true

# Duracion de la sesion del tutor, en minutos (7 dias por defecto).
ACCESS_TOKEN_MINUTES=10080

# Dias que se conservan los puntos de ubicacion en la base de datos.
LOCATION_RETENTION_DAYS=30

# Si el telefono del menor no consulta ordenes en este tiempo (segundos),
# las ordenes urgentes se envian tambien por SMS como respaldo.
SMS_FALLBACK_AFTER_SECONDS=90

# --- Twilio ------------------------------------------------------------------
# https://console.twilio.com  ->  Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Numero emisor comprado en Twilio, en formato E.164 (+598...).
TWILIO_FROM_NUMBER=+59800000000

# Validar la firma X-Twilio-Signature de los webhooks entrantes.
# Mantener en true en produccion. Ponlo en false solo para pruebas locales
# en las que Twilio no puede alcanzar tu PUBLIC_BASE_URL.
TWILIO_VALIDATE_SIGNATURE=true

# Nota: las cuentas Trial de Twilio solo permiten plantillas de SMS
# predefinidas (error 572006). Para mensajes personalizados hay que
# actualizar la cuenta a pago. Ver docs/TWILIO.md.

# Prefijo de los SMS que el menor recibe como respaldo cuando no tiene datos.
SMS_COMMAND_PREFIX=GEOSMS911

# --- Servidor ----------------------------------------------------------------
# Origenes permitidos para el dashboard separado (separados por coma) o "*".
CORS_ORIGINS=*
